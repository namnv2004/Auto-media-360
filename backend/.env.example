# Backend Environment Variables
ENVIRONMENT=development

# Database Settings
DATABASE_URL=postgresql://postgres:postgres@db:5432/automedia
REDIS_URL=redis://redis:6379/0

# Security (JWT)
SECRET_KEY=super-secret-key-please-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External API Keys (Crawler & AI)
OPENAI_API_KEY=sk-your-openai-api-key
YOUTUBE_API_KEY=your-youtube-v3-api-key
TIKTOK_API_KEY=your-tiktok-api-key
VIDIQ_API_KEY=your-vidiq-api-key
